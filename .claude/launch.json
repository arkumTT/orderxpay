{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "go",
      "runtimeArgs": ["-C", "src/api", "run", "./cmd/api"],
      "port": 8080
    },
    {
      "name": "back-office",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "src/back-office",
        "run",
        "dev",
        "--",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "src/web",
        "run",
        "dev",
        "--",
        "--port",
        "3001"
      ],
      "port": 3001
    }
  ]
}
