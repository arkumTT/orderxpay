ENV=development
PORT=8080

# Local dev only — see root docker-compose.yml.
DATABASE_URL=postgres://postgres:Xgonnagiveit2u@localhost:5432/orderxpay_dev?sslmode=disable

# Must be exactly 32 bytes. Generate with: openssl rand -hex 16
PASETO_SYMMETRIC_KEY=

# Section 9.1 — Paystack test/sandbox secret key (dashboard.paystack.com,
# free to sign up, no business vetting for test mode). Payment initiation
# returns a 501 until this is set.
PAYSTACK_SECRET_KEY=

# Customer-facing web app origin, used to build the Paystack callback_url
# the customer is redirected back to after paying.
WEB_BASE_URL=http://localhost:3000

# Section 4.4/6.2/7.3 — WhatsApp Cloud API (direct Meta, no BSP chosen yet).
# From a Meta App's WhatsApp product setup: a System User permanent access
# token (account-level, works across every merchant's phone number under
# the platform WhatsApp Business Account) and the App's Basic Settings
# secret (for verifying inbound webhook signatures — a different credential
# from the access token). Auto-reply silently doesn't fire until these are
# set, same as PAYSTACK_SECRET_KEY.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Any string you choose — Meta echoes it back during the webhook subscribe
# handshake (Facebook Developer Console > WhatsApp > Configuration).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Section 4.2 — item photo uploads, stored on local disk (no cloud storage
# account exists). UPLOAD_DIR is a filesystem path this process can write
# to; API_PUBLIC_BASE_URL is this API's own public origin, used to build
# the absolute image_url returned to clients — update it for a real
# deployment (defaults to localhost for local dev).
UPLOAD_DIR=./uploads
API_PUBLIC_BASE_URL=http://localhost:8080
