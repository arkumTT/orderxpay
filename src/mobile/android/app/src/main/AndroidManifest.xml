<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The app's own networking (every API call, starting with login) —
         not to be confused with android/app/src/debug/AndroidManifest.xml's
         own INTERNET declaration, which exists purely for Flutter's dev
         tooling (hot reload, breakpoints) and only merges into debug
         builds. Missing here meant every release build could install and
         launch fine but couldn't open a single socket: confirmed via
         `adb logcat` on a real device — every request failed at the OS
         level with "SocketException: Connection failed (OS Error:
         Operation not permitted, errno = 1)" — and via `aapt dump
         permissions` on the built APK, which listed every other
         permission below but not this one. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Section 4.3: lets the merchant pick a customer from their phone
         contacts on the New Order screen via flutter_contacts' native
         picker. Only READ (not WRITE) — the app never edits contacts. -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <!-- Section 4.2: taking a photo for a catalog item (New/Edit Item
         screen) via image_picker's camera source. Picking from the
         gallery uses the system Photo Picker and needs no permission
         declaration on modern Android. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Feedback item 4 — "Use current location" when adding/editing a
         pickup location, via geolocator. FINE (not just COARSE) so the
         reverse-geocoded address is actually street-accurate rather than
         landing a block or two off. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Section 4.10 Phase 2: required on Android 13+ (API 33) to actually
         display a push notification — without it, FCM still delivers the
         message but nothing shows. firebase_messaging's requestPermission()
         call (see push_notifications.dart) is what triggers the runtime
         prompt this declaration gates. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="orderxpay_mobile"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <!-- API_BASE_URL/WEB_BASE_URL (core/config.dart) point at a plain
             http:// LAN address during local/dev testing (no HTTPS cert for
             a machine's LAN IP) — Android blocks cleartext traffic by
             default on API 28+, which every build here targets, so without
             this every network call (starting with login) fails outright
             on a real device. Confirmed missing the hard way: a release
             APK built and installed on a physical phone couldn't log in at
             all until this was added. Harmless once a real HTTPS domain
             backs production — this flag only affects plain HTTP, never
             HTTPS. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Impeller (the default renderer) hangs indefinitely under the
             software-GL fallback this emulator uses on memory-constrained
             hosts. Force the legacy Skia backend so the app actually
             renders regardless of how it's launched (icon tap, am start,
             flutter run all read this, unlike the flutter run "no enable
             impeller" flag, which only applies to flutter run). Revisit
             once this stops being the dev bottleneck. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
